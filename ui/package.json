{
  "name": "kestrel-ui",
  "private": true,
  "version": "0.0.0",
  "description": "The Kestrel web UI: a static single-page app embedded in kestrel-server.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
